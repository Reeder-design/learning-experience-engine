{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reeder-design.github.io/learning-experience-engine/schemas/component.schema.json",
  "title": "Learning Experience Engine Component",
  "type": "object",
  "required": ["schemaVersion", "id", "title", "type", "content"],
  "properties": {
    "schemaVersion": { "const": "0.1" },
    "id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "type": {
      "enum": ["carousel", "hotspot-reveal", "assessment", "media-presentation", "branching-scenario"]
    },
    "description": { "type": ["string", "null"] },
    "instruction": { "type": ["string", "null"] },
    "theme": { "type": ["string", "null"] },
    "completion": {
      "type": "object",
      "properties": {
        "strategy": {
          "enum": ["view-all", "answer", "media-end", "reach-outcome", "manual", "none"]
        },
        "required": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "content": { "type": "object", "additionalProperties": true },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "allOf": [
    {
      "if": { "properties": { "type": { "const": "carousel" } } },
      "then": {
        "properties": {
          "content": {
            "required": ["items"],
            "properties": {
              "pageSize": { "type": "integer", "minimum": 1 },
              "items": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["id"],
                  "properties": {
                    "id": { "type": "string" },
                    "title": { "type": ["string", "null"] },
                    "body": { "type": ["string", "null"] },
                    "image": { "type": ["string", "null"] },
                    "alt": { "type": ["string", "null"] }
                  },
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "hotspot-reveal" } } },
      "then": {
        "properties": {
          "content": {
            "required": ["hotspots"],
            "properties": {
              "background": {
                "type": "object",
                "properties": {
                  "image": { "type": ["string", "null"] },
                  "alt": { "type": ["string", "null"] }
                },
                "additionalProperties": true
              },
              "hotspots": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["id", "x", "y", "label"],
                  "properties": {
                    "id": { "type": "string" },
                    "x": { "type": "number", "minimum": 0, "maximum": 100 },
                    "y": { "type": "number", "minimum": 0, "maximum": 100 },
                    "label": { "type": "string" },
                    "title": { "type": ["string", "null"] },
                    "body": { "type": ["string", "null"] },
                    "image": { "type": ["string", "null"] }
                  },
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "assessment" } } },
      "then": {
        "properties": {
          "content": {
            "required": ["questions"],
            "properties": {
              "questions": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["id", "prompt", "options"],
                  "properties": {
                    "id": { "type": "string" },
                    "prompt": { "type": "string" },
                    "type": { "enum": ["single-select"] },
                    "options": {
                      "type": "array",
                      "minItems": 2,
                      "items": {
                        "type": "object",
                        "required": ["id", "text", "correct"],
                        "properties": {
                          "id": { "type": "string" },
                          "text": { "type": "string" },
                          "correct": { "type": "boolean" },
                          "feedback": { "type": ["string", "null"] }
                        },
                        "additionalProperties": true
                      }
                    }
                  },
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "media-presentation" } } },
      "then": {
        "properties": {
          "content": {
            "required": ["media"],
            "properties": {
              "media": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["id", "kind", "src"],
                  "properties": {
                    "id": { "type": "string" },
                    "kind": { "enum": ["video", "audio"] },
                    "src": { "type": "string" },
                    "title": { "type": ["string", "null"] },
                    "caption": { "type": ["string", "null"] },
                    "transcript": { "type": ["string", "null"] }
                  },
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "branching-scenario" } } },
      "then": {
        "properties": {
          "content": {
            "required": ["startNodeId", "nodes", "outcomes"],
            "properties": {
              "startNodeId": { "type": "string", "minLength": 1 },
              "score": {
                "type": "object",
                "properties": {
                  "enabled": { "type": "boolean" },
                  "label": { "type": "string" },
                  "startingValue": { "type": "number" },
                  "minimum": { "type": "number" },
                  "maximum": { "type": "number" },
                  "showToLearner": { "type": "boolean" }
                },
                "additionalProperties": true
              },
              "nodes": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["id", "title", "choices"],
                  "properties": {
                    "id": { "type": "string", "minLength": 1 },
                    "title": { "type": "string" },
                    "speaker": { "type": ["string", "null"] },
                    "body": { "type": ["string", "null"] },
                    "image": { "type": ["string", "null"] },
                    "alt": { "type": ["string", "null"] },
                    "choices": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "object",
                        "required": ["id", "text", "targetId"],
                        "properties": {
                          "id": { "type": "string", "minLength": 1 },
                          "text": { "type": "string" },
                          "targetId": { "type": "string", "minLength": 1 },
                          "feedback": { "type": ["string", "null"] },
                          "scoreDelta": { "type": "number" }
                        },
                        "additionalProperties": true
                      }
                    }
                  },
                  "additionalProperties": true
                }
              },
              "outcomes": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["id", "title"],
                  "properties": {
                    "id": { "type": "string", "minLength": 1 },
                    "title": { "type": "string" },
                    "body": { "type": ["string", "null"] },
                    "image": { "type": ["string", "null"] },
                    "alt": { "type": ["string", "null"] },
                    "summary": { "type": ["string", "null"] }
                  },
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    }
  ],
  "additionalProperties": true
}
