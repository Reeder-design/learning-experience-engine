{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reeder-design.github.io/learning-experience-engine/schemas/lesson.schema.json",
  "title": "Learning Experience Engine Lesson",
  "type": "object",
  "required": ["schemaVersion", "id", "title", "kind", "blocks"],
  "properties": {
    "schemaVersion": {"const": "0.1"},
    "id": {"type": "string", "minLength": 1},
    "title": {"type": "string"},
    "kind": {"enum": ["section", "lesson"]},
    "description": {"type": ["string", "null"]},
    "objectives": {"type": "array", "items": {"type": "string"}},
    "metadata": {"type": "object", "additionalProperties": true},
    "source": {"type": "object", "additionalProperties": true},
    "blocks": {
      "type": "array",
      "items": {"$ref": "./block.schema.json"}
    }
  },
  "additionalProperties": true
}
